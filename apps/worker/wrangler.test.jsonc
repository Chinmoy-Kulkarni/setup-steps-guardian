{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "setup-steps-guardian-integration-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setup-steps-guardian-integration-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../packages/data/migrations"
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "0.0.0-integration-test",
    "PRODUCT_BASE_URL": "http://localhost:8787",
    "PADDLE_API_BASE_URL": "https://sandbox-api.paddle.com"
  }
}
